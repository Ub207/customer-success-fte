# ─────────────────────────────────────────────────────────────────────────────
# CRM Digital FTE Factory — environment template
# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM PROVIDER ───────────────────────────────────────────────────────────
# Pick exactly ONE. The agent selects a provider lazily on first run, using
# the first key present, in this order: OPENAI -> GROQ -> GEMINI.
# .env must be loaded before the first agent call.

# Paid — GPT-4o
OPENAI_API_KEY=

# Free — openai/gpt-oss-120b via Groq (https://console.groq.com)
GROQ_API_KEY=

# Free — gemini-1.5-flash via Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=


# ─── DATABASE ───────────────────────────────────────────────────────────────
# Local docker-compose default (host port 5433 -> container 5432):
DATABASE_URL=postgresql://fte_user:fte_password@localhost:5433/fte_db

# Or a managed cloud Postgres (Neon, Supabase, RDS, ...):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require


# ─── KAFKA ──────────────────────────────────────────────────────────────────
# Local docker-compose default (no auth):
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Or a managed cloud Kafka (Redpanda Cloud, Confluent Cloud):
# KAFKA_BOOTSTRAP_SERVERS=YOUR-BROKER:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=your-username
# KAFKA_SASL_PASSWORD=your-password


# ─── WHATSAPP (OPTIONAL — Twilio) ───────────────────────────────────────────
# Leave blank to run the web-form channel only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NGROK_URL=
WEBHOOK_BASE_URL=

# When TWILIO_AUTH_TOKEN is set, inbound WhatsApp webhooks must carry a
# valid X-Twilio-Signature header. Leave the token blank to skip the check
# (local development only).


# ─── GMAIL (OPTIONAL) ───────────────────────────────────────────────────────
GMAIL_USER_EMAIL=

# Shared token set on the Google Pub/Sub push subscription. When set,
# inbound Gmail webhooks must send "Authorization: Bearer <token>".
# Leave blank to skip the check (local development only).
PUBSUB_VERIFICATION_TOKEN=


# ─── OUTBOUND EMAIL / DAILY REPORT (OPTIONAL) ──────────────────────────────
# Web-form replies fall back to log-only when SMTP is not configured.
REPORT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ─── LOGGING ────────────────────────────────────────────────────────────────
# json (production) | console (local development)
LOG_FORMAT=console
